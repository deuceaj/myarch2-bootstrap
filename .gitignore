# This directory holds a full config backup (configs/) with real secrets:
# SSH private keys, SMB passwords (.smbcredentials*), Steam login tokens,
# Claude session transcripts, etc. Ignore everything by default and only
# explicitly allow files that have been reviewed as safe to publish.
*

# Explicitly allowed (reviewed — no secrets, no hardcoded passwords)
!.gitignore
!bootstrap.sh

# umbriel compositor config (reviewed: no secrets; contains LAN/Tailscale IPs
# in Remmina profile names and a Bluetooth speaker MAC). Generated
# noctalia.toml and *.bak* files are not copied in.
!configs/
!configs/.config/
!configs/.config/umbriel/
!configs/.config/umbriel/**

# noctalia shell config (reviewed: no secrets; services.toml holds a ZIP code
# for weather, hooks name the Obsidian vault paths). plugins/ is third-party
# code installed via noctalia's plugin manager, so it is not committed.
!configs/.config/noctalia/
!configs/.config/noctalia/**
!configs/.config/ai-usagebar/
!configs/.config/ai-usagebar/**
